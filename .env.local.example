# Copy this file to .env.local and fill in what you have.
# Never commit .env.local. Leave a line blank to keep that feature off.
# Full steps: docs/SETUP.md

# --- The app's own address (no trailing slash) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase: database, sign-in, file storage ---
# Without these two, the app runs in demo mode on sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for bank/QuickBooks connections, email-in, and adding teammates.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI invoice reading (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Encrypts bank and QuickBooks tokens. Any long random text: `openssl rand -base64 32` ---
TOKEN_ENCRYPTION_KEY=

# --- Plaid bank connections (dashboard.plaid.com) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- QuickBooks Online (developer.intuit.com) ---
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_ENVIRONMENT=sandbox

# --- Email-in invoices (Postmark inbound) ---
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# --- Daily bank refresh on Vercel. Any long random text. ---
CRON_SECRET=
